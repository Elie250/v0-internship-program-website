# Public API origin only — never put service-role keys, database URLs, or private secrets here.
# Shop staff APIs live on the shop host. Leave unset to use the production default.
#
# Production (default):
EXPO_PUBLIC_API_BASE_URL=https://shop.energyandlogics.com
#
# Local Next.js from an Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
#
# Local Next.js from a physical phone on the same Wi-Fi:
# EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:3000
