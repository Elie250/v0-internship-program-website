# Public API origin only — never put service-role keys, database URLs, or private secrets here.
# Shop customer and staff APIs live on the shop host. Leave unset to use the production default.
#
# Production (default for Expo Go on a physical phone):
EXPO_PUBLIC_API_BASE_URL=https://shop.energyandlogics.com
#
# Local Next.js from an Android emulator (development only):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
#
# Do not set this to localhost or 127.0.0.1. A physical phone cannot reach
# your computer that way. Release builds ignore local/LAN/HTTP overrides.
