{
  "expo": {
    "name": "Energy & Logics",
    "slug": "energy-and-logics-250",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/energy-logics-avatar-navy.png",
    "scheme": "energy-logics-shop",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a5f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.energyandlogics.staffpos"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/energy-logics-avatar-navy.png",
        "backgroundColor": "#1e3a5f"
      },
      "package": "com.energyandlogics.staffpos",
      "permissions": ["INTERNET"],
      "usesCleartextTraffic": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to scan products.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://shop.energyandlogics.com",
      "eas": {
        "projectId": "ed5c9cce-efb5-41ff-8720-0d34eab957dd"
      }
    }
  }
}
